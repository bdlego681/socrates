# Backend (copy to backend/.env)
PORT=3000
NODE_ENV=development
# Windows Integrated Security (local SQL Server / SQLEXPRESS)
DB_DRIVER=msnodesqlv8
DB_SERVER="localhost\SQLEXPRESS"
DB_DATABASE=personal_portal
DB_ODBC_DRIVER="ODBC Driver 18 for SQL Server"
SESSION_COOKIE_NAME=portal_session
SESSION_TTL_HOURS=24
# Generate a long random value for production; used to hash opaque session tokens.
SESSION_TOKEN_PEPPER=replace_with_a_long_random_value_for_production
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:4200
